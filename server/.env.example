PORT=3000
NODE_ENV=development

# Onde o arquivo do banco (almada.sqlite) fica salvo. Em produção, aponte
# para o disco persistente da hospedagem (ex: Render Disk) para os dados
# sobreviverem a deploys e reinícios. Local, pode deixar comentado.
# DATA_DIR=/var/data

# Usados apenas para criar o admin na primeira vez que o servidor roda
# (se a tabela de admins já tiver alguém, essas variáveis são ignoradas).
# Depois disso, troque a senha pelo painel Admin > Config > Atualizar credenciais.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
