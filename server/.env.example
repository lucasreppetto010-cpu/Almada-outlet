PORT=3000
NODE_ENV=development

# BANCO DE DADOS
# Em produção use o Turso (grátis): https://turso.tech
# Sem estas duas variáveis, o servidor usa o arquivo local server/data/almada.sqlite.
# TURSO_DATABASE_URL=libsql://almada-outlet-SEUUSUARIO.turso.io
# TURSO_AUTH_TOKEN=

# Usados apenas para criar o admin na primeira vez que o servidor roda
# (se a tabela de admins já tiver alguém, essas variáveis são ignoradas).
# Depois disso, troque a senha pelo painel Admin > Config > Atualizar credenciais.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Em produção use NODE_ENV=production: liga o redirecionamento para HTTPS,
# o cookie de login seguro e não cria os produtos de exemplo.

# RECUPERAR ACESSO (senha perdida):
#  - Com terminal:  npm run reset-admin -- NovaSenha [usuario]
#    (para o banco do Turso, rode com TURSO_DATABASE_URL e TURSO_AUTH_TOKEN no .env)
#  - Sem terminal (painel do Render > Environment): defina a variável abaixo,
#    salve (o Render reinicia sozinho), entre com a nova senha e DEPOIS APAGUE a variável.
# ADMIN_RESET_PASSWORD=
# ADMIN_RESET_USER=
